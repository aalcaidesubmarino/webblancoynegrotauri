# ==============================================================================
# 1. BASE DE DATOS NEON POSTGRESQL (NUEVA CUENTA / PROYECTO NEON)
# ==============================================================================
# Cadena de conexión con connection pooler (ideal para Serverless / Next.js / Queries rápidas)
DATABASE_URL="postgresql://[USUARIO]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/[DB_NAME]?sslmode=require"

# Cadena de conexión directa / unpooled (para migraciones Drizzle y WebSockets si aplica)
DATABASE_URL_UNPOOLED="postgresql://[USUARIO]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/[DB_NAME]?sslmode=require"

# Nombre de la rama principal de Neon (por defecto 'production' o 'main')
NEON_BRANCH="production"

# (Opcional) API Key de Neon si se desea gestión automatizada de ramas/Point-in-Time Restore desde el TPV
NEON_API_KEY=""
NEON_PROJECT_ID=""

# ==============================================================================
# 2. SEGURIDAD Y SINCRONIZACIÓN WEB (VERCEL / NEXT.JS)
# ==============================================================================
# Token secreto para validar llamadas de revalidación y sincronización de catálogo
REVALIDATE_SECRET="aura-pepi-secret-key"

# URL pública de producción de la web (en Vercel)
NEXT_PUBLIC_SITE_URL="https://webblancoynegro.vercel.app"
VERCEL_DEPLOY_HOOK=""

# Token de Vercel Blob para almacenamiento y CDN de imágenes optimizadas WebP
BLOB_READ_WRITE_TOKEN=""

# ==============================================================================
# 3. SERVIDOR DE CORREO SMTP (NOTIFICACIONES, ARQUEOS Y TICKETS POR EMAIL)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Blanco y Negro - Terapias Holísticas"
SMTP_FROM_EMAIL=""

# ==============================================================================
# 4. CONFIGURACIÓN DEL TPV LOCAL
# ==============================================================================
TPV_LOCAL_PORT="3742"
